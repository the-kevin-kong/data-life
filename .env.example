# Copy to .env for LOCAL development only. Never commit the real .env.
# In Cloud Run these come from Secret Manager, not this file.

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Terraform runs as this service account via impersonation (not your personal
# ADC) to avoid account conflicts. Covers BOTH the google provider and the GCS
# state backend. Your ADC identity needs roles/iam.serviceAccountTokenCreator
# on it. Leave unset to authenticate as ADC directly.
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=terraform-deployer@your-gcp-project-id.iam.gserviceaccount.com

# --- BigQuery datasets (source dataset name is owned by each ingestion pipeline) ---
BQ_STAGING_DATASET=staging
BQ_MARTS_DATASET=marts

# --- Secret Manager secret names (values live in GCP, not here) ---
MONARCH_EMAIL_SECRET=monarch-email
MONARCH_PASSWORD_SECRET=monarch-password
MONARCH_MFA_SECRET=monarch-mfa-secret
MONARCH_SESSION_SECRET=monarch-session

# --- Ingestion behavior ---
# How much transaction history to pull each run. Full history keeps
# soft-delete detection reliable; personal data is small.
INGEST_TRANSACTION_LOOKBACK_DAYS=3650

# --- Splitter behavior ---
SPLIT_TRIGGER_TAG_PREFIX=split:
SPLIT_DONE_TAG=split:done
SPLIT_DRY_RUN=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
